rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn()
        && profile().get('active', true) == true
        && profile().role in ['admin', 'operator'];
    }
    function admin() { return active() && profile().role == 'admin'; }
    function reporting() { return admin(); }
    function canRecord(sector) {
      return active() && (
        profile().role == 'admin' ||
        (profile().role == 'operator' && profile().get(sector, false) == true)
      );
    }
    function unitServices(sector) {
      return sector == 'parc'
        ? ['jumelage','navette','carburant','convoyeur']
        : ['esthetique','loueur','vo'];
    }
    function dailyServices(sector) {
      return sector == 'parc'
        ? ['chef-navette','inventaire','controle']
        : ['entree','sortie','diagnostic','pneumatiques','batterie','controle-esthetique'];
    }
    function allServices(sector) {
      return sector == 'parc'
        ? ['jumelage','navette','carburant','convoyeur','chef-navette','inventaire','controle']
        : ['esthetique','loueur','vo','entree','sortie','diagnostic','pneumatiques','batterie','controle-esthetique'];
    }
    function validServiceList(ids, allowed, minimum) {
      return ids is list
        && ids.size() >= minimum
        && ids.size() <= 16
        && ids.hasOnly(allowed);
    }
    function validLegacyServices(data) {
      return data.kind in ['unit', 'daily']
        && validServiceList(
          data.serviceIds,
          data.kind == 'unit' ? unitServices(data.sector) : dailyServices(data.sector),
          1
        );
    }
    function validMixedServices(data) {
      return data.serviceIds is list && data.serviceIds.size() >= 1 && data.serviceIds.size() <= 16
        && data.unitServiceIds is list && data.unitServiceIds.size() <= 16
        && data.dailyServiceIds is list && data.dailyServiceIds.size() <= 16
        && data.newlyCountedDailyServiceIds is list && data.newlyCountedDailyServiceIds.size() <= 16
        && data.alreadyCountedDailyServiceIds is list && data.alreadyCountedDailyServiceIds.size() <= 16;
    }
    function validEntry() {
      return request.resource.data.keys().hasOnly([
          'sector','kind','vehicle','location','serviceIds','unitServiceIds','dailyServiceIds',
          'newlyCountedDailyServiceIds','alreadyCountedDailyServiceIds',
          'date','operatorId','operatorName','tariffVersion','createdAt'
        ])
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.operatorName is string
        && request.resource.data.operatorName.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.tariffVersion is string
        && request.resource.data.tariffVersion == get(/databases/$(database)/documents/settings/tariff).data.version
        && request.resource.data.createdAt == request.time
        && request.resource.data.sector in ['parc', 'atelier']
        && (
          (
            request.resource.data.keys().hasAll([
              'unitServiceIds','dailyServiceIds','newlyCountedDailyServiceIds','alreadyCountedDailyServiceIds'
            ])
            && validMixedServices(request.resource.data)
            && request.resource.data.vehicle is string
            && request.resource.data.vehicle.size() >= 4
            && request.resource.data.vehicle.size() <= 17
            && (request.resource.data.sector != 'parc' || (
              request.resource.data.location is string
              && request.resource.data.location.size() > 0
              && request.resource.data.location.size() <= 50
            ))
          ) ||
          (
            request.resource.data.keys().hasAll(['kind'])
            && validLegacyServices(request.resource.data)
            && (
              (request.resource.data.kind == 'daily'
                && request.resource.data.vehicle == ''
                && request.resource.data.location == '') ||
              (request.resource.data.kind == 'unit'
                && request.resource.data.vehicle is string
                && request.resource.data.vehicle.size() >= 4
                && request.resource.data.vehicle.size() <= 17
                && (request.resource.data.sector != 'parc' || (
                  request.resource.data.location is string
                  && request.resource.data.location.size() > 0
                  && request.resource.data.location.size() <= 50
                )))
            )
          )
        );
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if admin() && request.auth.uid != uid;
      allow delete: if false;
    }

    // Catalogue dynamique : visible par les comptes actifs, administrable
    // uniquement par un administrateur. Une prestation appartient à un seul secteur.
    match /services/{serviceId} {
      allow read: if active();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly([
          'name','sector','kind','priceCents','createdAt','createdBy','updatedAt','updatedBy'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.sector in ['parc', 'atelier']
        && request.resource.data.kind in ['unit', 'daily']
        && (request.resource.data.priceCents == null || (
          request.resource.data.priceCents is int
          && request.resource.data.priceCents >= 0
          && request.resource.data.priceCents <= 100000000
        ));
      allow delete: if admin();
    }

    match /entries/{id} {
      allow get: if reporting() || (active() && id.matches(request.auth.uid + '_.*'));
      allow list: if reporting() || (active() && resource.data.operatorId == request.auth.uid);
      allow create: if canRecord(request.resource.data.sector) && validEntry();
      allow update, delete: if admin();
    }

    match /dailyLocks/{id} {
      allow get: if active();
      allow list: if false;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['operationId','operatorId','date','serviceId','sector','createdAt'])
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.operationId is string
        && request.resource.data.date is string
        && request.resource.data.sector in ['parc', 'atelier']
        && request.resource.data.serviceId is string
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.sector == request.resource.data.sector
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.kind == 'daily'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if admin();
    }

    // Les opérateurs peuvent connaître l'ID de la version active, jamais ses montants.
    match /settings/tariff {
      allow get: if active();
      allow list: if false;
      allow create, update: if admin();
      allow delete: if false;
    }

    // Les montants restent réservés au pilotage financier admin/responsable.
    match /tariffVersions/{id} {
      allow read: if reporting();
      allow create: if admin();
      allow update, delete: if false;
    }

    match /audit/{id} {
      allow read: if admin();
      allow create: if admin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
